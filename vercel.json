{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/supabase/:__supabase_path*", "destination": "/api/supabase?__supabase_path=:__supabase_path*" },
    { "source": "/((?!api(?:/|$)|supabase(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ]
}
