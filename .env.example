# Copy to .env.local for local production builds. Local PostgreSQL dev needs no env.
# Set these in Vercel Environment Variables for production and preview deployments.
# Use the selected TCF User's Database project and its public publishable key.
VITE_SUPABASE_URL=https://snbfdktwrgzhwjqmyhdz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_PUBLIC_KEY
# Backend selection is automatic: dev = PostgreSQL, build = Supabase.
# PostgreSQL credentials are generated privately under .local-db/.
# Optional initial owner setup: configure these ONLY in Vercel Production.
# SUPER_ADMIN_EMAIL=your-owner@example.com
# SUPER_ADMIN_PASSWORD=<your chosen 12-128 character password>
# SUPABASE_SECRET_KEY=<selected project's server-side secret key>
