{
  "name": "gym-active-member-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode supabase",
    "dev:local": "vite --mode localdb",
    "check:supabase": "node scripts/check-supabase-connection.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "test:local": "node --test server/local/api.test.mjs",
    "build": "vite build --mode supabase",
    "build:local": "vite build --mode localdb --outDir dist-local",
    "preview": "vite preview --mode supabase",
    "preview:local": "vite preview --mode localdb --outDir dist-local",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.5",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "pg": "8.23.1",
    "vite": "^8.2.0"
  }
}
